# Copier vers .env et remplir. Ne jamais committer .env.

# PostgreSQL (Neon, Railway ou autre)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# OpenAI
AI_INTEGRATIONS_OPENAI_API_KEY=sk-...
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Port du backend en local (Railway le fournit automatiquement en production)
PORT=3001
BASE_PATH=/
